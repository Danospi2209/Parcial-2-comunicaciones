{
  "uid": "joomla-postgres-dash",
  "title": "Panel de Monitoreo General",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Conexiones activas a PostgreSQL",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, conexiones AS \"Conexiones\" FROM metricas WHERE $__timeFilter(ts) ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Actividad: transacciones y filas leidas por intervalo",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, GREATEST(xact_commit - lag(xact_commit) OVER (ORDER BY ts), 0) AS \"Transacciones\", GREATEST(tup_fetched - lag(tup_fetched) OVER (ORDER BY ts), 0) AS \"Filas leidas\" FROM metricas WHERE $__timeFilter(ts) ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Sesiones de visitantes en Joomla por minuto",
      "description": "Requiere que Joomla haya terminado su instalacion automatica (1-2 min tras el arranque) y haber navegado por el sitio.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-ds" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "showPoints": "never" },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('minute', to_timestamp(\"time\")) AS time, count(*) AS \"Sesiones\" FROM jml_session WHERE $__timeFilter(to_timestamp(\"time\")) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tablas creadas en PostgreSQL",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "postgres-ds" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS tablas FROM information_schema.tables WHERE table_schema = 'public'"
        }
      ]
    }
  ]
}